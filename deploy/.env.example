# 复制为 deploy/.env 后填写（只放在服务器上，不要提交到 git）。

# 与模型配置中的 apiKeyEnv 对应
MODEL_API_KEY=
TENCENT_API_KEY=
DEEPSEEK_API_KEY=
HAIHUB_API_KEY=
OPENROUTER_API_KEY=

# 管理员账号密码。看板和决策日志对外公开；模型管理、立即运行一轮和原项目接口需要登录。
# 不设置密码时，管理操作只允许在服务器本机进行。请用 16 位以上的随机密码，例如：openssl rand -base64 18
ARENA_USER=admin
ARENA_PASSWORD=

LOG_LEVEL=info
